# ─── ApiCore Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in the values for local development.
# On Render, set these as Environment Variables in the dashboard.

# JWT secret — use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret

# Frontend URL (used for CORS). Comma-separate multiple origins.
# Example: https://apicore-frontend.onrender.com,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# For LOCAL development: leave DATABASE_URL unset → uses SQLite automatically.
# For PRODUCTION (Render): set DATABASE_URL to your Render PostgreSQL connection
# string. Render sets this automatically when you use render.yaml with a
# `fromDatabase` reference. For manual setup, copy the "Internal Database URL"
# from your Render PostgreSQL dashboard.
#
# Example:
#   DATABASE_URL=postgresql://apicore_user:PASSWORD@dpg-XXXX-a/apicore
DATABASE_URL=

# SQLite fallback path (only used when DATABASE_URL is NOT set)
DATABASE_PATH=

# Node environment
NODE_ENV=development

# Port (Render sets this automatically — do not change on Render)
PORT=5001
